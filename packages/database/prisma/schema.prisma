generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  ADMIN
  AGENT
}

enum TrainType {
  RAJDHANI
  SHATABDI
  EXPRESS
  SUPERFAST
  MAIL
}

enum CoachType {
  SLEEPER
  AC_3
  AC_2
  AC_1
  GENERAL
  CC
}

enum SeatType {
  LOWER
  MIDDLE
  UPPER
  SIDE_LOWER
  SIDE_UPPER
  WINDOW
  AISLE
}

enum Quota {
  GENERAL
  TATKAL
  LADIES
  SENIOR
  DIVYANG
}

enum BookingStatus {
  INITIATED
  CONFIRMED
  WAITLISTED
  RAC
  CANCELLED
  EXPIRED
}

enum SeatStatus {
  HELD
  CONFIRMED
  CANCELLED
  WAITLISTED
  EXPIRED
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  phone             String       @unique
  passwordHash      String       @map("password_hash")
  fullName          String       @map("full_name")
  role              Role         @default(PASSENGER)
  aadhaarHash       String?      @map("aadhaar_hash")
  isVerified        Boolean      @default(false) @map("is_verified")
  deviceFingerprint String?      @map("device_fingerprint")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  passengers        Passenger[]
  bookings          Booking[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]

  @@index([email], name: "idx_user_email")
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Station {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. NDLS
  name      String
  city      String
  state     String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now()) @map("created_at")

  routes TrainRoute[]

  bookingsFrom Booking[] @relation("BookingFromStation")
  bookingsTo   Booking[] @relation("BookingToStation")

  @@map("stations")
}

model Train {
  id           String    @id @default(uuid())
  trainNumber  String    @unique @map("train_number")
  name         String
  trainType    TrainType @default(EXPRESS) @map("train_type")
  isActive     Boolean   @default(true) @map("is_active")
  totalCoaches Int       @default(12) @map("total_coaches")
  createdAt    DateTime  @default(now()) @map("created_at")

  routes   TrainRoute[]
  coaches  Coach[]
  bookings Booking[]

  @@map("trains")
}

model TrainRoute {
  id            String   @id @default(uuid())
  trainId       String   @map("train_id")
  stationId     String   @map("station_id")
  sequenceNo    Int      @map("sequence_no")
  arrivalTime   String?  @map("arrival_time") // HH:mm format
  departureTime String?  @map("departure_time") // HH:mm format
  distanceKm    Int      @default(0) @map("distance_km")
  dayOffset     Int      @default(0) @map("day_offset") // 0 = day 1, 1 = day 2

  train   Train   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([trainId, sequenceNo])
  @@index([stationId, trainId], name: "idx_route_station")
  @@map("train_routes")
}

model Coach {
  id          String    @id @default(uuid())
  trainId     String    @map("train_id")
  coachNumber String    @map("coach_number") // e.g. S1, B1, A1
  coachType   CoachType @map("coach_type")
  totalSeats  Int       @default(72) @map("total_seats")

  train Train  @relation(fields: [trainId], references: [id], onDelete: Cascade)
  seats Seat[]

  @@unique([trainId, coachNumber])
  @@map("coaches")
}

model Seat {
  id          String   @id @default(uuid())
  coachId     String   @map("coach_id")
  seatNumber  String   @map("seat_number") // e.g. 1, 2, 72
  seatType    SeatType @map("seat_type")
  quota       Quota    @default(GENERAL)

  coach        Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  @@unique([coachId, seatNumber], name: "unique_coach_seat")
  @@index([coachId, seatNumber], name: "idx_seat_coach")
  @@index([quota], name: "idx_seat_quota")
  @@map("seats")
}

model Passenger {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  age       Int
  gender    String
  idType    String?  @map("id_type")
  idNumber  String?  @map("id_number")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  @@map("passengers")
}

model Booking {
  id             String        @id @default(uuid())
  pnrNo          String        @unique @map("pnr_no") // 10-digit
  userId         String        @map("user_id")
  trainId        String        @map("train_id")
  fromStationId  String        @map("from_station_id")
  toStationId    String        @map("to_station_id")
  journeyDate    DateTime      @map("journey_date")
  bookingStatus  BookingStatus @default(INITIATED) @map("booking_status")
  coachClass     CoachType     @map("coach_class")
  quota          Quota         @default(GENERAL)
  totalFare      Decimal       @map("total_fare") @db.Decimal(10, 2)
  idempotencyKey String        @unique @map("idempotency_key")
  bookedAt       DateTime      @default(now()) @map("booked_at")
  expiresAt      DateTime?     @map("expires_at")
  cancelledAt    DateTime?     @map("cancelled_at")

  user        User        @relation(fields: [userId], references: [id])
  train       Train       @relation(fields: [trainId], references: [id])
  fromStation Station     @relation("BookingFromStation", fields: [fromStationId], references: [id])
  toStation   Station     @relation("BookingToStation", fields: [toStationId], references: [id])
  seats       BookingSeat[]
  payment     Payment?

  @@index([userId], name: "idx_booking_user")
  @@index([trainId, journeyDate], name: "idx_booking_train_date")
  @@index([pnrNo], name: "idx_booking_pnr")
  @@index([bookingStatus], name: "idx_booking_status")
  @@map("bookings")
}

model BookingSeat {
  id            String     @id @default(uuid())
  bookingId     String     @map("booking_id")
  seatId        String     @map("seat_id")
  passengerId   String     @map("passenger_id")
  status        SeatStatus @default(HELD)
  lockedAt      DateTime   @default(now()) @map("locked_at")
  lockExpiresAt DateTime   @map("lock_expires_at")

  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat      Seat      @relation(fields: [seatId], references: [id])
  passenger Passenger @relation(fields: [passengerId], references: [id])

  @@index([bookingId], name: "idx_bseat_booking")
  @@index([seatId, status], name: "idx_bseat_coach_seat")
  @@map("booking_seats")
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique @map("booking_id")
  orderId           String        @unique @map("order_id") // Razorpay order_id
  transactionId     String?       @map("transaction_id")
  paymentMethod     PaymentMethod @default(UPI) @map("payment_method")
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(INITIATED)
  gatewayResponse   Json?         @map("gateway_response")
  retryCount        Int           @default(0) @map("retry_count")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([orderId], name: "idx_payment_order")
  @@map("payments")
}

model OutboxEvent {
  id        String   @id @default(uuid())
  eventType String   @map("event_type")
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("outbox_events")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  ipAddress String?  @map("ip_address")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
